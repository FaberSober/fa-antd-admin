# H5 可使用相对路径，通过 vite proxy 转发到本地后端。
VITE_APP_API_BASE_URL=/api

# 微信小程序必须使用完整地址，不能使用 /api；请替换为后端可访问的局域网或 HTTPS 地址。
VITE_APP_MP_API_BASE_URL=http://192.168.1.158/api

# App 真机同样不能使用 /api；请按实际环境修改。
VITE_APP_APP_API_BASE_URL=http://192.168.1.158/api

# 当前后端开发服务默认使用 80 端口；如环境不同请修改。
VITE_DEV_PROXY_TARGET=http://127.0.0.1

VITE_APP_NAME=Fa Mobile
VITE_APP_VERSION_NAME=0.0.1
VITE_APP_VERSION_CODE=1
VITE_APP_FA_FROM=FaApp

# Telemetry 应用管理中配置的 appKey；为空时不启用客户端上报。
VITE_APP_TELEMETRY_APP_KEY=
VITE_APP_TELEMETRY_ENV=development
