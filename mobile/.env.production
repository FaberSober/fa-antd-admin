VITE_APP_HTTP_LOG_ENABLED=false

# H5 可使用相对路径，通过 vite proxy 转发到本地后端。
VITE_APP_API_BASE_URL=/api

# 微信小程序必须使用完整地址，不能使用 /api；请替换为后端可访问的局域网或 HTTPS 地址。
VITE_APP_MP_API_BASE_URL=https://fa.dward.cn/api

# App 真机同样不能使用 /api；请按实际环境修改。
VITE_APP_APP_API_BASE_URL=https://fa.dward.cn/api

# H5 文件预览地址。H5 端可使用相对路径，小程序和 App 真机请使用 HTTPS 完整地址。
VITE_APP_H5_PREVIEW_BASE_URL=/h5/preview
VITE_APP_MP_H5_PREVIEW_BASE_URL=https://fa.dward.cn/h5/preview
VITE_APP_APP_H5_PREVIEW_BASE_URL=https://fa.dward.cn/h5/preview

VITE_APP_NAME=Fa Mobile
VITE_APP_VERSION_NAME=0.0.1
VITE_APP_VERSION_CODE=1
VITE_APP_FA_FROM=FaApp

# fa-app 中 app_apk.short_code 对应的公开应用标识；为空时不检查更新。
VITE_APP_UPDATE_APP_CODE=famb
VITE_APP_UPDATE_CHANNEL=stable

# H5 CDN 版本清单地址，例如 https://cdn.example.com/mobile/version.json；为空时不检查 H5 更新。
VITE_APP_H5_UPDATE_MANIFEST_URL=

# Telemetry 应用管理中配置的 appKey；为空时不启用客户端上报。
VITE_APP_TELEMETRY_APP_KEY=fa-mobile-prod
VITE_APP_TELEMETRY_ENV=production
