{
  "name": "fa-admin",
  "private": true,
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "ncu:all": "turbo run ncu",
    "ncu": "ncu -u",
    "dev": "turbo run dev --parallel",
    "dev:admin": "turbo run dev --filter=@fa/admin",
    "dev:h5": "turbo run dev --filter=@fa/h5",
    "dev:portal": "turbo run dev --filter=@fa/portal",
    "build": "turbo run build",
    "build:apps": "pnpm --filter=@fa/admin --filter=@fa/h5 --filter=@fa/portal run build",
    "lint": "turbo run lint",
    "check": "turbo run check",
    "lint-staged": "lint-staged",
    "clean": "turbo run clean && rimraf /s/d node_modules",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && pnpm release:only",
    "release:only": "changeset publish --registry=https://registry.npmjs.com/"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.13",
    "@changesets/cli": "2.27.11",
    "@types/node": "22.20.1",
    "lefthook": "1.10.10",
    "npm-check-updates": "17.1.14",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "rimraf": "6.0.1",
    "turbo": "latest"
  },
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=18.12.0",
    "pnpm": ">=8.7.0"
  }
}
